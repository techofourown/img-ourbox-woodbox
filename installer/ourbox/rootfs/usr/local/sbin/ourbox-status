#!/usr/bin/env bash
set -euo pipefail

# ourbox-status — persistent boot-time status reporter
#
# Polls system state every 10s during boot, writes to /dev/console
# and /run/ourbox/status (read by MOTD and `woodbox status`).
# Switches to 60s interval once all services are ready.
# Silenced by `woodbox quiet` (creates /var/lib/ourbox/state/quiet).

QUIET_MARKER="/var/lib/ourbox/state/quiet"
STATUS_DIR="${OURBOX_STATUS_RUN_DIR:-/run/ourbox}"
STATUS_FILE="${STATUS_DIR}/status"
BOOT_INTERVAL=10
READY_INTERVAL=60
HOSTNAME="$(hostname)"
PLATFORM_STATE_FILE="/var/lib/ourbox/state/platform-contract.env"
APP_SURFACE_FILE="/var/lib/ourbox/state/selected-app-surface.json"
STATUS_BASE_URL="${OURBOX_STATUS_BASE_URL:-http://127.0.0.1}"

mkdir -p "${STATUS_DIR}"

# Always start loud on boot.
rm -f "$QUIET_MARKER"

check_data_mount() {
  mountpoint -q /var/lib/ourbox 2>/dev/null
}

check_network() {
  ip -o -4 addr show scope global up 2>/dev/null \
    | awk '{split($4,a,"/"); print a[1]}' | head -n1
}

check_k3s_api() {
  /usr/local/bin/k3s kubectl get nodes --no-headers 2>/dev/null | grep -q .
}

env_file_value() {
  local file="$1" key="$2"
  [[ -f "${file}" ]] || return 1
  awk -F= -v wanted="${key}" '
    $1 == wanted {
      value = substr($0, index($0, "=") + 1)
      gsub(/^"/, "", value)
      gsub(/"$/, "", value)
      gsub(/^'\''/, "", value)
      gsub(/'\''$/, "", value)
      print value
      exit
    }
  ' "${file}"
}

resolved_box_host() {
  local box_host=""
  box_host="$(env_file_value "${PLATFORM_STATE_FILE}" "BOX_HOST" || true)"
  if [[ -n "${box_host}" ]]; then
    printf '%s\n' "${box_host}"
  else
    printf '%s.local\n' "${HOSTNAME}"
  fi
}

surface_exists() {
  [[ -f "${APP_SURFACE_FILE}" ]] || return 1
  python3 - "${APP_SURFACE_FILE}" <<'PY' >/dev/null 2>&1
import json
import sys
from pathlib import Path

surface = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
apps = surface.get("apps")
if surface.get("kind") != "ourbox-selected-app-surface":
    raise SystemExit(1)
if surface.get("schema") != 1:
    raise SystemExit(1)
if not isinstance(apps, list):
    raise SystemExit(1)
PY
}

surface_app_urls() {
  [[ -f "${APP_SURFACE_FILE}" ]] || return 1
  python3 - "${APP_SURFACE_FILE}" <<'PY'
import json
import sys
from pathlib import Path

surface = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for app in surface.get("apps", []):
    url = str(app.get("url", "")).strip()
    if url:
        print(url)
PY
}

surface_mdns_hosts() {
  [[ -f "${APP_SURFACE_FILE}" ]] || return 1
  python3 - "${APP_SURFACE_FILE}" <<'PY'
import json
import sys
from pathlib import Path

surface = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
seen = set()
for app in surface.get("apps", []):
    if not bool(app.get("publish_mdns_alias", False)):
        continue
    host = str(app.get("host", "")).strip()
    if not host or host in seen:
        continue
    seen.add(host)
    print(host)
PY
}

surface_landing_selected() {
  [[ -f "${APP_SURFACE_FILE}" ]] || return 1
  python3 - "${APP_SURFACE_FILE}" <<'PY' >/dev/null 2>&1
import json
import sys
from pathlib import Path

surface = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
raise SystemExit(0 if bool(surface.get("landing_selected", False)) else 1)
PY
}

check_traefik() {
  local box_host="$1"
  python3 - "${box_host}" <<'PY' >/dev/null 2>&1
import sys
import urllib.error
import urllib.request

box_host = sys.argv[1]

try:
    request = urllib.request.Request("http://127.0.0.1/", headers={"Host": box_host})
    with urllib.request.urlopen(request, timeout=2) as response:
        sys.exit(0 if getattr(response, "status", 200) else 0)
except (OSError, urllib.error.URLError):
    sys.exit(1)
PY
}

check_mdns() {
  local mdns_hosts=""
  mdns_hosts="$(surface_mdns_hosts || true)"
  if surface_exists && [[ -z "${mdns_hosts}" ]]; then
    return 0
  fi
  systemctl is-active --quiet ourbox-mdns-aliases 2>/dev/null
}

check_bootstrap_done() {
  [[ -f /var/lib/ourbox/state/bootstrap.done ]]
}

check_pods_ready() {
  local total ready
  total="$(/usr/local/bin/k3s kubectl get pods -n ourbox-system --no-headers 2>/dev/null | wc -l)"
  ready="$(/usr/local/bin/k3s kubectl get pods -n ourbox-system --no-headers 2>/dev/null | grep -c 'Running' || true)"
  if (( total > 0 && total == ready )); then
    return 0
  fi
  echo "${ready}/${total}"
  return 1
}

check_app_status_endpoint() {
  local box_host="$1"
  [[ -f "${APP_SURFACE_FILE}" ]] || {
    echo "waiting for rendered app surface"
    return 1
  }
  python3 - "${APP_SURFACE_FILE}" "${box_host}" "${STATUS_BASE_URL}" <<'PY'
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

surface = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
box_host = sys.argv[2]
status_base_url = sys.argv[3]
status_route = surface.get("status_route")
if not bool(surface.get("landing_selected", False)) or not isinstance(status_route, dict):
    print("status route not required")
    raise SystemExit(2)

expected_ids = [
    str(app.get("id", "")).strip()
    for app in surface.get("apps", [])
    if bool(app.get("include_in_status", False)) and str(app.get("id", "")).strip()
]
path = str(status_route.get("path", "")).strip() or "/_ourbox/app-status.json"

try:
    request = urllib.request.Request(f"{status_base_url}{path}", headers={"Host": box_host})
    with urllib.request.urlopen(request, timeout=3) as response:
        status_code = getattr(response, "status", 200)
        payload = json.load(response)
except (OSError, ValueError, urllib.error.URLError):
    print("waiting for app-status endpoint")
    raise SystemExit(1)

if status_code != 200:
    print(f"app-status HTTP {status_code}")
    raise SystemExit(1)

cluster_status = str(payload.get("cluster_status", "")).strip()
if cluster_status and cluster_status != "ok":
    print(f"cluster status {cluster_status}")
    raise SystemExit(1)

apps = payload.get("apps", [])
if not isinstance(apps, list):
    print("malformed app-status payload")
    raise SystemExit(1)

actual_ids = [str(app.get("id", "")).strip() for app in apps if str(app.get("id", "")).strip()]
if sorted(actual_ids) != sorted(expected_ids):
    print(f"app-status ids mismatch ({len(actual_ids)} actual / {len(expected_ids)} expected)")
    raise SystemExit(1)

healthy_ids = [
    str(app.get("id", "")).strip()
    for app in apps
    if str(app.get("status", "")).strip() == "healthy" and str(app.get("id", "")).strip()
]
if sorted(healthy_ids) != sorted(expected_ids):
    print(f"{len(healthy_ids)}/{len(expected_ids)} apps healthy")
    raise SystemExit(1)

print(f"{len(expected_ids)}/{len(expected_ids)} apps healthy")
PY
}

format_status() {
  local ip="$1" box_host="$2" data_ok="$3" net_ok="$4" k3s_ok="$5" traefik_ok="$6"
  local surface_ok="$7" mdns_ok="$8" bootstrap_ok="$9" pods_info="${10}" all_ready="${11}"
  local app_urls="${12}" landing_selected="${13}" app_status_ok="${14}" app_status_summary="${15}"

  local mark_ok="OK" mark_wait=".." mark_no="  "
  local out=""

  out+="--- OurBox Woodbox Status ---"$'\n'

  if [[ "$data_ok" == "1" ]]; then
    out+="  [${mark_ok}] DATA disk mounted"$'\n'
  else
    out+="  [${mark_wait}] DATA disk: waiting for mount"$'\n'
  fi

  if [[ "$net_ok" == "1" ]]; then
    out+="  [${mark_ok}] Network: ${ip}"$'\n'
  else
    out+="  [${mark_wait}] Network: waiting for DHCP"$'\n'
  fi

  if [[ "$k3s_ok" == "1" ]]; then
    out+="  [${mark_ok}] k3s API: running"$'\n'
  elif [[ "$net_ok" == "1" ]]; then
    out+="  [${mark_wait}] k3s API: starting"$'\n'
  else
    out+="  [${mark_no}] k3s API: waiting for network"$'\n'
  fi

  if [[ "$traefik_ok" == "1" ]]; then
    out+="  [${mark_ok}] Traefik: listening on port 80"$'\n'
  elif [[ "$k3s_ok" == "1" ]]; then
    out+="  [${mark_wait}] Traefik: deploying"$'\n'
  else
    out+="  [${mark_no}] Traefik: waiting for k3s"$'\n'
  fi

  if [[ "$surface_ok" == "1" ]]; then
    out+="  [${mark_ok}] App surface: loaded"$'\n'
  elif [[ "$bootstrap_ok" == "1" ]]; then
    out+="  [${mark_wait}] App surface: missing rendered state"$'\n'
  else
    out+="  [${mark_wait}] App surface: waiting for bootstrap render"$'\n'
  fi

  if [[ "$landing_selected" == "1" ]]; then
    if [[ "$app_status_ok" == "1" ]]; then
      out+="  [${mark_ok}] Apps: ${app_status_summary}"$'\n'
    elif [[ "$surface_ok" == "1" && "$traefik_ok" == "1" ]]; then
      out+="  [${mark_wait}] Apps: ${app_status_summary}"$'\n'
    elif [[ "$surface_ok" == "1" ]]; then
      out+="  [${mark_wait}] Apps: waiting for app-status route"$'\n'
    else
      out+="  [${mark_no}] Apps: waiting for rendered app surface"$'\n'
    fi
  elif [[ "$k3s_ok" == "1" && "$surface_ok" == "1" ]]; then
    if [[ "$pods_info" == "ready" ]]; then
      out+="  [${mark_ok}] Apps: all running"$'\n'
    else
      out+="  [${mark_wait}] Apps: ${pods_info} pods running"$'\n'
    fi
  elif [[ "$k3s_ok" == "1" ]]; then
    out+="  [${mark_wait}] Apps: waiting for rendered app surface"$'\n'
  else
    out+="  [${mark_no}] Apps: waiting for k3s"$'\n'
  fi

  if [[ "$mdns_ok" == "1" ]]; then
    out+="  [${mark_ok}] mDNS: aliases published"$'\n'
  elif [[ "$net_ok" == "1" ]]; then
    out+="  [${mark_wait}] mDNS: starting"$'\n'
  else
    out+="  [${mark_no}] mDNS: waiting for network"$'\n'
  fi

  if [[ "$bootstrap_ok" != "1" ]]; then
    out+=$'\n'
    out+="  First boot in progress — this takes several minutes."$'\n'
    out+="  Do not power off the device."$'\n'
  fi

  if [[ "$all_ready" == "1" ]]; then
    out+=$'\n'
    out+="  ========================================"$'\n'
    out+="    OurBox Woodbox is READY"$'\n\n'
    while IFS= read -r app_url; do
      [[ -n "${app_url}" ]] || continue
      out+="    ${app_url}"$'\n'
    done <<<"${app_urls}"
    out+=$'\n'
    out+="    Commands:"$'\n'
    out+="      woodbox status  — show this status"$'\n'
    out+="      woodbox quiet   — silence console output"$'\n'
    out+="      woodbox loud    — resume console output"$'\n'
    out+="  ========================================"$'\n'
  fi

  echo "$out"
}

was_ready=false

while true; do
  data_ok=0; check_data_mount && data_ok=1
  net_ok=0; ip=""; ip="$(check_network)"; [[ -n "$ip" ]] && net_ok=1
  box_host="$(resolved_box_host)"
  k3s_ok=0; check_k3s_api && k3s_ok=1
  traefik_ok=0; check_traefik "${box_host}" && traefik_ok=1
  surface_ok=0; surface_exists && surface_ok=1
  mdns_ok=0; check_mdns && mdns_ok=1
  bootstrap_ok=0; check_bootstrap_done && bootstrap_ok=1

  pods_info="0/0"
  if [[ "$k3s_ok" == "1" ]]; then
    pods_info="$(check_pods_ready)" && pods_info="ready"
  fi

  landing_selected=0
  if [[ "$surface_ok" == "1" ]]; then
    surface_landing_selected && landing_selected=1 || true
  fi

  app_status_ok=0
  app_status_summary="waiting for rendered app surface"
  if [[ "$surface_ok" == "1" ]]; then
    if [[ "$landing_selected" == "1" ]]; then
      if app_status_summary="$(check_app_status_endpoint "${box_host}")"; then
        app_status_ok=1
      fi
      if [[ -z "${app_status_summary}" ]]; then
        app_status_summary="waiting for app-status endpoint"
      fi
    else
      app_status_summary="status route not required"
    fi
  fi

  all_ready=0
  if [[ "$data_ok$net_ok$k3s_ok$traefik_ok$surface_ok$mdns_ok$bootstrap_ok" == "1111111" ]]; then
    if [[ "$landing_selected" == "1" ]]; then
      [[ "$app_status_ok" == "1" ]] && all_ready=1
    elif [[ "$pods_info" == "ready" ]]; then
      all_ready=1
    fi
  fi

  app_urls="$(surface_app_urls || true)"

  status="$(format_status "$ip" "$box_host" "$data_ok" "$net_ok" "$k3s_ok" "$traefik_ok" \
    "$surface_ok" "$mdns_ok" "$bootstrap_ok" "$pods_info" "$all_ready" "$app_urls" \
    "$landing_selected" "$app_status_ok" "$app_status_summary")"

  echo "$status" > "${STATUS_FILE}"

  if [[ ! -f "$QUIET_MARKER" ]]; then
    echo "" > /dev/console 2>/dev/null || true
    echo "$status" > /dev/console 2>/dev/null || true
  fi

  if [[ "$all_ready" == "1" ]]; then
    if [[ "$was_ready" == "false" ]]; then
      was_ready=true
    fi
    sleep "$READY_INTERVAL"
  else
    sleep "$BOOT_INTERVAL"
  fi
done
