#!/usr/bin/env bash
set -euo pipefail

STATUS_FILE="/run/ourbox/status"
BOOTSTRAP_STATUS_FILE="/run/ourbox/bootstrap-status.env"
BOOTSTRAP_ERROR_FILE="/var/lib/ourbox/state/bootstrap-last-error.txt"
BOOTSTRAP_LOG_FILE="/var/lib/ourbox/state/bootstrap-last-log.txt"
PLATFORM_STATE_FILE="/var/lib/ourbox/state/platform-contract.env"
APP_SURFACE_STATE_FILE="/var/lib/ourbox/state/selected-app-surface.json"
PLATFORM_DIR="/opt/ourbox/substrate/platform"

section() {
  printf '\n== %s ==\n' "$1"
}

show_file() {
  local label="$1" path="$2"
  section "${label}"
  if [[ -f "${path}" ]]; then
    cat "${path}"
  else
    printf 'missing: %s\n' "${path}"
  fi
}

show_tail() {
  local label="$1" path="$2" lines="$3"
  section "${label}"
  if [[ -f "${path}" ]]; then
    tail -n "${lines}" "${path}"
  else
    printf 'missing: %s\n' "${path}"
  fi
}

section "identity"
printf 'host=%s\n' "$(hostname)"
printf 'user=%s\n' "$(id -un)"
printf 'uid=%s\n' "$(id -u)"

show_file "runtime status" "${STATUS_FILE}"
show_file "bootstrap status" "${BOOTSTRAP_STATUS_FILE}"
show_file "bootstrap last error" "${BOOTSTRAP_ERROR_FILE}"
show_tail "bootstrap last log (tail)" "${BOOTSTRAP_LOG_FILE}" 120

show_file "applied platform state" "${PLATFORM_STATE_FILE}"
show_file "selected app surface" "${APP_SURFACE_STATE_FILE}"

section "platform intent files"
ls -l "${PLATFORM_DIR}" 2>/dev/null || printf 'missing: %s\n' "${PLATFORM_DIR}"
if compgen -G "${PLATFORM_DIR}/*.json" >/dev/null 2>&1; then
  sha256sum "${PLATFORM_DIR}"/*.json 2>/dev/null || true
fi

section "services"
systemctl --no-pager --full status ourbox-bootstrap.service || true
systemctl --no-pager --full status ourbox-status.service || true
systemctl --no-pager --full status k3s.service || true

section "bootstrap journal"
journalctl -u ourbox-bootstrap.service -b --no-pager -n 200 || true
