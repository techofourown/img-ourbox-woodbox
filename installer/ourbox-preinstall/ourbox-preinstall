    validate_installed_target_ssh_authorized_key "${MISSION_INSTALLED_TARGET_SSH_AUTHORIZED_KEY_PATH}"
    cp -f "${MISSION_INSTALLED_TARGET_SSH_AUTHORIZED_KEY_PATH}" "${staged_installed_target_authorized_key}"
    log "Installed-target SSH mission key staged into installer cache: ${staged_installed_target_authorized_key}"
  else
    rm -f "${staged_installed_target_authorized_key}"
    log "Installed-target SSH mission key staging skipped: no embedded mission key present"
  fi

  cat > "${cache_dir}/configure-installed-target-ssh.sh" <<SCRIPT
#!/bin/sh
set -e
TARGET="\${1:-/target}"
SSH_PASSWORD_ENABLED=$(shell_quote_sh "${OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED:-0}")
SSH_KEY_PRESENT=$(shell_quote_sh "${MISSION_INSTALLED_TARGET_SSH_PRESENT:-0}")
SSH_USERNAME=$(shell_quote_sh "${OURBOX_USERNAME:-ourbox}")
USER_PASSWORD_HASH=$(shell_quote_sh "${OURBOX_PASSWORD_HASH:-}")
SSH_KEY_NAME=$(shell_quote_sh "${MISSION_INSTALLED_TARGET_SSH_KEY_NAME}")
SSH_KEY_FINGERPRINT=$(shell_quote_sh "${MISSION_INSTALLED_TARGET_SSH_PUBLIC_KEY_FINGERPRINT}")
AUTHORIZED_KEY_SRC=$(shell_quote_sh "${staged_installed_target_authorized_key}")
SSH_PACKAGE_MANIFEST=$(shell_quote_sh "${installed_target_ssh_packages_manifest}")
SSH_PACKAGE_INSTALLER=$(shell_quote_sh "${OFFLINE_TARGET_PACKAGE_INSTALLER}")
SSH_REPO_DIR=$(shell_quote_sh "${OFFLINE_TARGET_APT_REPO_DIR}")

echo "Installed-target SSH inputs: key=\${SSH_KEY_PRESENT} password=\${SSH_PASSWORD_ENABLED}"
if [ "\${SSH_KEY_PRESENT}" = "1" ]; then
  echo "Installed-target SSH staged key: \${AUTHORIZED_KEY_SRC} (\${SSH_KEY_NAME}: \${SSH_KEY_FINGERPRINT})"
fi

if [ "\${SSH_PASSWORD_ENABLED}" != "1" ] && [ "\${SSH_KEY_PRESENT}" != "1" ]; then
  echo "Installed-target SSH is disabled; skipping SSH package install and configuration"
  exit 0
fi

"\${SSH_PACKAGE_INSTALLER}" \
  --target "\${TARGET}" \
  --repo-dir "\${SSH_REPO_DIR}" \
  --package-manifest "\${SSH_PACKAGE_MANIFEST}"

# The OS payload overlay (late command [1/12]) replaces /target/etc/passwd and
# /target/etc/shadow with the pre-built payload rootfs versions, removing the
# autoinstall-created user. Recreate the user so login and SSH both work.
if ! awk -F: -v u="\${SSH_USERNAME}" '\$1 == u {found=1} END{exit !found}' "\${TARGET}/etc/passwd"; then
  echo "Installed target user \${SSH_USERNAME} absent after OS payload overlay; recreating"
  curtin in-target --target="\${TARGET}" -- useradd -m -s /bin/bash -G sudo "\${SSH_USERNAME}"
  printf '%s:%s\n' "\${SSH_USERNAME}" "\${USER_PASSWORD_HASH}" | curtin in-target --target="\${TARGET}" -- chpasswd -e
  echo "Installed target user \${SSH_USERNAME} recreated"
fi

password_authentication="no"
if [ "\${SSH_PASSWORD_ENABLED}" = "1" ]; then
  password_authentication="yes"
fi

mkdir -p "\${TARGET}/etc/ssh/sshd_config.d"
cat > "\${TARGET}/etc/ssh/sshd_config.d/60-ourbox-installed-target.conf" <<EOF
PasswordAuthentication \${password_authentication}
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
EOF

if [ "\${SSH_KEY_PRESENT}" = "1" ]; then
  [ -f "\${AUTHORIZED_KEY_SRC}" ] || { echo "missing staged installed-target SSH authorized key: \${AUTHORIZED_KEY_SRC}" >&2; exit 1; }
  user_record="\$(awk -F: -v user="\${SSH_USERNAME}" '\$1 == user {print \$3 ":" \$4 ":" \$6; exit}' "\${TARGET}/etc/passwd")"
  [ -n "\${user_record}" ] || { echo "installed target user not found in \${TARGET}/etc/passwd: \${SSH_USERNAME}" >&2; exit 1; }
  user_uid="\$(printf '%s' "\${user_record}" | cut -d: -f1)"
  user_gid="\$(printf '%s' "\${user_record}" | cut -d: -f2)"
  user_home="\$(printf '%s' "\${user_record}" | cut -d: -f3)"
  [ -n "\${user_home}" ] || { echo "installed target user home is empty for \${SSH_USERNAME}" >&2; exit 1; }
  install -d -m 0700 "\${TARGET}\${user_home}/.ssh"
  install -m 0600 "\${AUTHORIZED_KEY_SRC}" "\${TARGET}\${user_home}/.ssh/authorized_keys"
  if [ "\$(id -u)" = "0" ]; then
    chown "\${user_uid}:\${user_gid}" "\${TARGET}\${user_home}/.ssh" "\${TARGET}\${user_home}/.ssh/authorized_keys"
  fi
  echo "Installed-target SSH key staged for \${SSH_USERNAME} (\${SSH_KEY_NAME}: \${SSH_KEY_FINGERPRINT})"
fi

curtin in-target --target="\${TARGET}" -- systemctl enable ssh.service
echo "Installed-target SSH configured (\$( [ "\${SSH_KEY_PRESENT}" = "1" ] && printf 'key' || printf 'no-key' ) / \$( [ "\${SSH_PASSWORD_ENABLED}" = "1" ] && printf 'password' || printf 'no-password' ))"
SCRIPT
  chmod +x "${cache_dir}/configure-installed-target-ssh.sh"
}

# ---------------------------------------------------------------------------
# identity
# ---------------------------------------------------------------------------

prompt_nonempty() {
  local prompt="$1" default="${2:-}" ans=""
  if [[ -n "${default}" ]]; then
    read -r -p "  ${prompt} [${default}]: " ans
    ans="${ans:-${default}}"
  else
    read -r -p "  ${prompt}: " ans
  fi
  [[ -n "${ans}" ]] || die "value required"
  echo "${ans}"
}

prompt_password_hash() {
  local pw1="" pw2=""
  while true; do
    # echo after read -s moves the cursor to a new line; must go to stderr
    # so that only the hash is captured by $(...) on stdout.
    read -r -s -p "  Password: " pw1; echo >&2
    read -r -s -p "  Confirm:  " pw2; echo >&2
    [[ -n "${pw1}" ]] || { echo "  Password cannot be empty." >&2; continue; }
    [[ "${pw1}" == "${pw2}" ]] || { echo "  Passwords did not match. Try again." >&2; continue; }
    printf '%s' "${pw1}" | openssl passwd -6 -stdin
    return 0
  done
}

prompt_optional_password_hash() {
  local pw1="" pw2=""
  while true; do
    read -r -s -p "  Installer SSH password (press Enter to keep current posture): " pw1; echo >&2
    if [[ -z "${pw1}" ]]; then
      echo ""
      return 0
    fi
    read -r -s -p "  Confirm installer SSH password: " pw2; echo >&2
    [[ "${pw1}" == "${pw2}" ]] || { echo "  Passwords did not match. Try again." >&2; continue; }
    echo "${pw1}" | openssl passwd -6 -stdin
    return 0
  done
}

shell_assign() {
  local name="$1" value="$2"
  printf '%s=' "${name}"
  printf '%q\n' "${value}"
}

apply_installer_ssh_password_override() {
  local password_hash="$1"
  local ssh_mode="" ssh_user="" ssh_allow_root="" ssh_keys=""
  local defaults_tmp=""

  [[ -n "${password_hash}" ]] || return 0
  [[ -f "${DEFAULTS_ENV}" ]] || die "missing installer defaults: ${DEFAULTS_ENV}"

  # shellcheck disable=SC1090
  source "${DEFAULTS_ENV}"
  ssh_mode="${OURBOX_INSTALLER_SSH_MODE:-both}"
  ssh_user="${OURBOX_INSTALLER_SSH_USER:-ourbox-installer}"
  ssh_allow_root="${OURBOX_INSTALLER_SSH_ALLOW_ROOT:-0}"
  ssh_keys="${OURBOX_INSTALLER_SSH_AUTHORIZED_KEYS:-}"

  case "${ssh_mode}" in
    password|both) ;;
    *)
      die "installer media is not password-capable (OURBOX_INSTALLER_SSH_MODE=${ssh_mode})"
      ;;
  esac

  defaults_tmp="$(mktemp)"
  {
    shell_assign "OURBOX_INSTALLER_SSH_MODE" "${ssh_mode}"
    shell_assign "OURBOX_INSTALLER_SSH_USER" "${ssh_user}"
    shell_assign "OURBOX_INSTALLER_SSH_PASSWORD_HASH" "${password_hash}"
    shell_assign "OURBOX_INSTALLER_SSH_AUTHORIZED_KEYS" "${ssh_keys}"
    shell_assign "OURBOX_INSTALLER_SSH_ALLOW_ROOT" "${ssh_allow_root}"
  } > "${defaults_tmp}"

  if DEFAULTS_FILE="${defaults_tmp}" /bin/bash /cdrom/ourbox/tools/ourbox-installer-ssh-bootstrap.sh >> "${INSTALLER_LOG}" 2>&1; then
    rm -f "${defaults_tmp}"
    return 0
  fi

  rm -f "${defaults_tmp}"
  die "failed to apply live-installer SSH password override"
}

optional_installer_ssh_password_step() {
  local ssh_mode="" ssh_user="" password_hash=""

  [[ -f "${DEFAULTS_ENV}" ]] || die "missing installer defaults: ${DEFAULTS_ENV}"

  # shellcheck disable=SC1090
  source "${DEFAULTS_ENV}"
  ssh_mode="${OURBOX_INSTALLER_SSH_MODE:-both}"
  ssh_user="${OURBOX_INSTALLER_SSH_USER:-ourbox-installer}"

  banner
  echo "  Step 0: Optional installer SSH password"
  echo

  case "${ssh_mode}" in
    password|both)
      echo "  Set a temporary password for the live installer SSH account (${ssh_user})."
      echo "  Press ENTER to keep the current installer SSH posture."
      echo "  This password only applies to the installer environment."
      echo
      password_hash="$(prompt_optional_password_hash)"
      if [[ -z "${password_hash}" ]]; then
        echo "  Keeping current installer SSH posture."
        echo
        return 0
      fi
      apply_installer_ssh_password_override "${password_hash}"
      banner
      echo "  Installer SSH password updated for ${ssh_user}."
      echo
      ;;
    *)
      echo "  This media is not password-capable for installer SSH (mode=${ssh_mode})."
      echo "  Press ENTER to continue."
      echo
      read -r
      ;;
  esac
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

main() {
  banner

  udevadm settle --timeout=10 || true

  optional_installer_ssh_password_step

  # --- Step 1: OS disk ---
  echo "  Step 1 of 6: Select the OS disk"
  echo "  This disk will be ERASED and OurBox Woodbox OS installed on it."
  echo "  Showing all non-removable, non-USB disks."
  echo "  Recommendation: use a faster SSD/NVMe drive for best performance."

  TARGET_DISK=""
  TARGET_DISK_SERIAL=""
  select_disk

  echo
  echo "  OS disk     : ${TARGET_DISK}"
  echo "  Disk serial : ${TARGET_DISK_SERIAL:-unknown}"
  echo

  # --- Step 2: DATA disk ---
  banner
  echo "  Step 2 of 6: Select the DATA disk"
  echo "  This disk will be formatted as the OurBox data volume."
  echo "  Showing all non-OS, non-removable disks."

  DATA_DISK=""
  select_data_disk

  echo
  echo "  DATA disk   : ${DATA_DISK}"
  echo

  # --- Step 3: OS artifact ---
  banner
  echo "  Step 3 of 6: Load the staged OS payload"
  echo "  This install uses only the mission bytes already on this media."
  echo
  resolve_and_stage_os_artifact

  # --- Step 4: Airgap platform ---
  banner
  echo "  Step 4 of 6: Stage the selected airgap-platform bundle"
  echo "  Using the host-selected airgap bundle staged on this mission media."
  echo "  No target-side registry browsing or pulling will be used."
  echo
  prepare_selected_airgap_platform_bundle
  stage_selected_application_metadata
  show_airgap_platform_panel
  show_selected_applications_panel
  write_install_provenance

  # --- Step 5: Identity + installed-system SSH ---
  banner
  echo "  Step 5 of 6: Set identity and installed-system SSH"
  echo "  (You can change hostname, password, and SSH posture later.)"
  echo

  OURBOX_HOSTNAME="$(prompt_nonempty "Hostname" "ourbox-woodbox")"
  OURBOX_USERNAME="$(prompt_nonempty "Username" "ourbox")"

  echo
  echo "  Set the login password for ${OURBOX_USERNAME}:"
  OURBOX_PASSWORD_HASH="$(prompt_password_hash)"
  prompt_installed_target_ssh_password_posture
  write_offline_install_helpers

  # --- Step 6: Summary + final confirmation ---
  banner
  echo "  Step 6 of 6: Confirm and install"
  echo
  echo "  OS disk      : ${TARGET_DISK}"
  [[ -n "${TARGET_DISK_SERIAL}" ]] && \
    echo "  Disk serial  : ${TARGET_DISK_SERIAL}"
  echo "  DATA disk    : ${DATA_DISK}"
  echo "  OS artifact  : ${OS_ARTIFACT_REF}"
  echo "  Selection    : ${INSTALL_SELECTION_SOURCE}"
  if [[ -n "${RELEASE_CHANNEL}" ]]; then
    echo "  Channel      : ${RELEASE_CHANNEL}"
  fi
  echo "  OS digest    : ${OS_ARTIFACT_DIGEST:-unknown}"
  echo "  OS SHA256    : ${OS_IMAGE_SHA256}"
  echo "  Apps bundle  : ${OURBOX_AIRGAP_PLATFORM_REF:-unknown}"
  echo "  Apps source  : ${OURBOX_AIRGAP_PLATFORM_ARTIFACT_SOURCE:-unknown}"
  echo "  Apps select  : ${OURBOX_AIRGAP_PLATFORM_SELECTION_SOURCE:-unknown}"
  if [[ -n "${OURBOX_AIRGAP_PLATFORM_RELEASE_CHANNEL}" ]]; then
    echo "  Apps lane    : ${OURBOX_AIRGAP_PLATFORM_RELEASE_CHANNEL}"
  fi
  echo "  Apps digest  : ${OURBOX_AIRGAP_PLATFORM_DIGEST:-unknown}"
  if [[ -n "${OURBOX_APPLICATION_CATALOG_ID}" ]]; then
    echo "  App catalog  : ${OURBOX_APPLICATION_CATALOG_NAME:-unknown} (${OURBOX_APPLICATION_CATALOG_ID})"
    echo "  App mode     : ${OURBOX_APPLICATION_SELECTION_MODE:-unknown}"
    echo "  Applications : ${OURBOX_SELECTED_APPLICATION_IDS:-unknown}"
  fi
  echo "  Contract     : ${REQUIRED_AIRGAP_PLATFORM_CONTRACT_DIGEST:-unknown}"
  _load_installer_ssh_status
  case "${OURBOX_INSTALLER_SSH_PASSWORD_STATE}" in
    configured-hash)
      echo "  Installer SSH: operator-set temporary password"
      ;;
    generated-console-only)
      echo "  Installer SSH: console-only generated password"
      ;;
  esac
  echo "  Hostname     : ${OURBOX_HOSTNAME}"
  echo "  Username     : ${OURBOX_USERNAME}"
  echo "  Target SSH   : $(installed_target_ssh_summary_mode)"
  if [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" == "1" ]]; then
    echo "  SSH key      : ${MISSION_INSTALLED_TARGET_SSH_KEY_NAME} (${MISSION_INSTALLED_TARGET_SSH_PUBLIC_KEY_FINGERPRINT})"
  fi
  echo
  echo "  WARNING: ALL DATA ON ${TARGET_DISK} AND ${DATA_DISK} WILL BE PERMANENTLY ERASED."
  echo "  This includes old LVM, RAID, encrypted, swap, and filesystem metadata on the DATA disk."
  echo
  prompt_confirm_exact "INSTALL" "  Type INSTALL to begin (or Ctrl-C to abort):"

  # Prepare DATA disk immediately after final confirmation, before Subiquity handoff.
  TARGET_DISK_REAL="$(readlink -f "${TARGET_DISK}")"
  DATA_DISK_REAL="$(readlink -f "${DATA_DISK}")"

  echo
  echo "  Preparing DATA disk now..."
  echo "  This may take a moment if the disk contains old LVM, RAID, or encrypted metadata."
  echo

  /bin/bash /cdrom/ourbox/tools/format-data-disk.sh "${DATA_DISK_REAL}" "${TARGET_DISK_REAL}"

  echo
  echo "  DATA disk prepared successfully."
  echo

  # --- generate autoinstall.yaml ---
  export OURBOX_HOSTNAME OURBOX_USERNAME OURBOX_PASSWORD_HASH \
    OURBOX_DATA_DISK="${DATA_DISK_REAL}" \
    OURBOX_TARGET_DISK="${TARGET_DISK_REAL}"

  # Match by device path (for example /dev/nvme0n1 or /dev/sda) rather than serial number.
  # Subiquity's prober reads the serial directly from sysfs, which includes
  # trailing spaces (e.g. "794PCBKPPQKN        ").  lsblk strips those spaces,
  # so a serial-based match always fails.  Path matching is unambiguous and
  # requires no serial normalization.
  OURBOX_STORAGE_MATCH="        path: ${TARGET_DISK_REAL}"
  export OURBOX_STORAGE_MATCH
  OURBOX_INSTALLED_TARGET_SSH_AUTOINSTALL_BLOCK="$(render_installed_target_ssh_autoinstall_block)"
  export OURBOX_INSTALLED_TARGET_SSH_AUTOINSTALL_BLOCK

  [[ -f "${AUTOINSTALL_TPL}" ]] || die "missing runtime template: ${AUTOINSTALL_TPL}"

  # shellcheck disable=SC2016  # single-quoted intentionally — envsubst needs literal $VAR strings
  RUNTIME_VARS='${OURBOX_HOSTNAME} ${OURBOX_USERNAME} ${OURBOX_PASSWORD_HASH} ${OURBOX_STORAGE_MATCH} ${OURBOX_DATA_DISK} ${OURBOX_TARGET_DISK} ${OURBOX_INSTALLED_TARGET_SSH_AUTOINSTALL_BLOCK}'
  envsubst "${RUNTIME_VARS}" < "${AUTOINSTALL_TPL}" > "${AUTOINSTALL_OUT}"

  echo
  echo "  =================================================================="
  echo "  Handoff summary"
  echo "  =================================================================="
  echo "  OS disk       : ${TARGET_DISK} (${TARGET_DISK_REAL})"
  echo "  DATA disk     : ${DATA_DISK} (${DATA_DISK_REAL})"
  echo "  OS artifact   : ${OS_ARTIFACT_REF}"
  echo "  OS SHA256     : ${OS_IMAGE_SHA256}"
  echo "  Apps bundle   : ${OURBOX_AIRGAP_PLATFORM_REF:-unknown}"
  echo "  Apps digest   : ${OURBOX_AIRGAP_PLATFORM_DIGEST:-unknown}"
  if [[ -n "${OURBOX_APPLICATION_CATALOG_ID}" ]]; then
    echo "  App catalog   : ${OURBOX_APPLICATION_CATALOG_NAME:-unknown} (${OURBOX_APPLICATION_CATALOG_ID})"
    echo "  Applications  : ${OURBOX_SELECTED_APPLICATION_IDS:-unknown}"
  fi
  echo "  Hostname      : ${OURBOX_HOSTNAME}"
  echo "  Username      : ${OURBOX_USERNAME}"
  echo "  Target SSH    : $(installed_target_ssh_summary_mode)"
  if [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" == "1" ]]; then
    echo "  SSH key       : ${MISSION_INSTALLED_TARGET_SSH_KEY_NAME} (${MISSION_INSTALLED_TARGET_SSH_PUBLIC_KEY_FINGERPRINT})"
  fi
  echo "  Autoinstall   : ${AUTOINSTALL_OUT}"
  echo "  =================================================================="
  echo
  echo "  Handing off to Subiquity. Ubuntu base install begins now."
  echo
  echo "  Progress is shown below as Subiquity runs."
  echo "  The machine will POWER OFF when installation is complete."
  echo "  The installer will try to prefer the installed OS for the next UEFI boot."
  echo "  Do NOT remove the USB stick until the machine powers off."
  echo "  When power is off: remove USB, then press power button to boot."
  echo
  echo "  To diagnose issues during this phase (on another TTY):"
  echo "    Alt-F2  : open a shell"
  echo "    cat /run/ourbox-installer.log   (bootcmd + installer log)"
  echo "    cat ${AUTOINSTALL_OUT}   (config Subiquity is using)"
  echo "    journalctl -fu ourbox-preinstall.service"
  echo "  =================================================================="
  echo
}

if [[ "${OURBOX_PREINSTALL_LIBRARY_ONLY:-0}" != "1" ]]; then
  main "$@"
fi
