    raise SystemExit("embedded mission target.id must be 'woodbox'")
operator_mode = manifest.get("operator_mode", {})
if operator_mode.get("mode") != "install":
    raise SystemExit("embedded mission operator_mode.mode must be 'install'")

selected_os = manifest.get("selected_os", {})
selected_airgap = manifest.get("selected_airgap", {})
selected_applications = manifest.get("selected_applications")
installed_target_ssh = manifest.get("installed_target_ssh")
supported_selection_modes = {"catalog-defaults", "all-apps", "custom"}

app_present = False
app_catalog_id = ""
app_catalog_name = ""
app_selection_mode = ""
app_selected_ids = ""
app_catalog_relpath = ""
app_selection_relpath = ""
installed_target_ssh_present = False
installed_target_ssh_mode = ""
installed_target_ssh_key_name = ""
installed_target_ssh_authorized_key_relpath = ""
installed_target_ssh_key_type = ""
installed_target_ssh_public_key_fingerprint = ""

if not isinstance(selected_applications, dict) or not selected_applications:
    raise SystemExit("embedded mission selected_applications must be present")
else:
    app_catalog_id = str(selected_applications.get("catalog_id", ""))
