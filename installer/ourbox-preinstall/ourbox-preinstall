load_mission_selected_application_metadata() {
  if [[ "${MISSION_SELECTED_APPLICATIONS_PRESENT}" != "1" ]]; then
    OURBOX_APPLICATION_CATALOG_ID=""
    OURBOX_APPLICATION_CATALOG_NAME=""
    OURBOX_APPLICATION_SELECTION_MODE=""
    OURBOX_SELECTED_APPLICATION_IDS=""
    return 0
  fi

  [[ -f "${MISSION_APPLICATION_CATALOG_PATH}" ]] || die "embedded mission application catalog missing: ${MISSION_APPLICATION_CATALOG_PATH}"
  [[ -f "${MISSION_SELECTED_APPLICATIONS_PATH}" ]] || die "embedded mission selected applications file missing: ${MISSION_SELECTED_APPLICATIONS_PATH}"

  python3 - <<'PY' \
    "${MISSION_APPLICATION_CATALOG_PATH}" \
    "${MISSION_SELECTED_APPLICATIONS_PATH}" \
    "${MISSION_APPLICATION_CATALOG_ID}" \
    "${MISSION_APPLICATION_CATALOG_NAME}" \
    "${MISSION_APPLICATION_SELECTION_MODE}" \
    "${MISSION_SELECTED_APPLICATION_IDS}"
import json
import pathlib
import sys

catalog_path = pathlib.Path(sys.argv[1])
selected_path = pathlib.Path(sys.argv[2])
expected_catalog_id = sys.argv[3]
expected_catalog_name = sys.argv[4]
expected_selection_mode = sys.argv[5]
expected_selected_ids = [item for item in sys.argv[6].split(",") if item]

with catalog_path.open("r", encoding="utf-8") as handle:
    catalog = json.load(handle)
with selected_path.open("r", encoding="utf-8") as handle:
    selected = json.load(handle)

if catalog.get("schema") != 1:
    raise SystemExit("embedded mission application catalog must declare schema=1")
if catalog.get("kind") != "ourbox-application-catalog":
    raise SystemExit("embedded mission application catalog kind must be 'ourbox-application-catalog'")
if str(catalog.get("catalog_id", "")) != expected_catalog_id:
    raise SystemExit("embedded mission application catalog id does not match mission manifest")
if str(catalog.get("catalog_name", "")) != expected_catalog_name:
    raise SystemExit("embedded mission application catalog name does not match mission manifest")
catalog_apps = catalog.get("apps")
if not isinstance(catalog_apps, list) or not catalog_apps:
    raise SystemExit("embedded mission application catalog must declare a non-empty apps list")
catalog_app_ids = set()
for app in catalog_apps:
    app_id = str(app.get("id", "")).strip()
    if not app_id:
        raise SystemExit("embedded mission application catalog contains an app without an id")
    catalog_app_ids.add(app_id)
unknown_ids = [app_id for app_id in expected_selected_ids if app_id not in catalog_app_ids]
if unknown_ids:
    raise SystemExit("embedded mission selected applications must be a subset of the application catalog")

if selected.get("schema") != 1:
    raise SystemExit("embedded mission selected applications must declare schema=1")
if selected.get("kind") != "ourbox-selected-applications":
    raise SystemExit("embedded mission selected applications kind must be 'ourbox-selected-applications'")
if str(selected.get("catalog_id", "")) != expected_catalog_id:
    raise SystemExit("embedded mission selected applications catalog_id does not match mission manifest")
selection_mode = str(selected.get("selection_mode", ""))
if selection_mode not in {"catalog-defaults", "all-apps", "custom"}:
    raise SystemExit("embedded mission selected applications selection_mode is out of contract")
if selection_mode != expected_selection_mode:
    raise SystemExit("embedded mission selected applications selection_mode does not match mission manifest")

selected_ids = selected.get("selected_app_ids")
if not isinstance(selected_ids, list) or not selected_ids:
    raise SystemExit("embedded mission selected applications must declare a non-empty selected_app_ids list")

normalized_ids = []
seen_ids = set()
for raw_app_id in selected_ids:
    app_id = str(raw_app_id).strip()
    if not app_id:
        raise SystemExit("embedded mission selected applications contains an empty app id")
    if app_id in seen_ids:
        raise SystemExit(f"embedded mission selected applications duplicates app id {app_id}")
    seen_ids.add(app_id)
    normalized_ids.append(app_id)

if normalized_ids != expected_selected_ids:
    raise SystemExit("embedded mission selected applications file does not match mission manifest selected_app_ids")
PY

  OURBOX_APPLICATION_CATALOG_ID="${MISSION_APPLICATION_CATALOG_ID}"
  OURBOX_APPLICATION_CATALOG_NAME="${MISSION_APPLICATION_CATALOG_NAME}"
  OURBOX_APPLICATION_SELECTION_MODE="${MISSION_APPLICATION_SELECTION_MODE}"
  OURBOX_SELECTED_APPLICATION_IDS="${MISSION_SELECTED_APPLICATION_IDS}"
}

verify_mission_selected_airgap_tarball() {
  local tarball="$1"
  local checksum_file="${tarball}.sha256"
  [[ -f "${checksum_file}" ]] || die "embedded mission airgap checksum missing: ${checksum_file}"

  local expected="" actual=""
  expected="$(awk 'NF>=1 {print $1; exit}' "${checksum_file}")"
  expected="${expected,,}"
  [[ "${expected}" =~ ^[0-9a-f]{64}$ ]] || die "invalid sha256 in embedded mission checksum file: ${checksum_file}"
  actual="$(sha256sum "${tarball}" | awk '{print $1}')"
  [[ "${expected}" == "${actual}" ]] || die "embedded mission airgap SHA256 mismatch: expected ${expected}, got ${actual}"
}

stage_embedded_mission_airgap_bundle() {
  verify_mission_selected_airgap_tarball "${MISSION_AIRGAP_PAYLOAD_PATH}"

  OURBOX_AIRGAP_PLATFORM_REF="${MISSION_AIRGAP_ARTIFACT_REF}"
