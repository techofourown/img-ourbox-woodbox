#!/usr/bin/env bash
# OurBox Woodbox — pre-installer
# Runs on TTY1 before Subiquity. Collects disk + identity from the operator,
# writes /autoinstall.yaml, then exits so Subiquity can run fully automated.
set -euo pipefail

# Tee all output to the installer log so the network monitor can broadcast it.
# The monitor (ourbox-installer-monitor.py) tails this file and rebroadcasts
# each line via UDP and an HTTP viewer on port 8888.
INSTALLER_LOG="/run/ourbox-installer.log"
if [[ "${OURBOX_PREINSTALL_LIBRARY_ONLY:-0}" != "1" ]]; then
  exec > >(tee -a "${INSTALLER_LOG}") 2>&1
fi

TOOLS_ROOT="${OURBOX_PREINSTALL_TOOLS_ROOT:-/cdrom/ourbox/tools}"
# shellcheck disable=SC1091
source "${TOOLS_ROOT}/lib.sh"
# shellcheck disable=SC1091
source "${TOOLS_ROOT}/installer-selection-resolver.sh"

need_cmd lsblk
need_cmd readlink
need_cmd findmnt
need_cmd udevadm
need_cmd openssl
need_cmd envsubst
need_cmd awk
need_cmd sed

AUTOINSTALL_TPL="/cdrom/ourbox/autoinstall.tpl"
AUTOINSTALL_OUT="/autoinstall.yaml"
DEFAULTS_ENV="/cdrom/ourbox/installer/defaults.env"
PAYLOAD_CACHE_DIR="/opt/ourbox/installer/cache/payload"
SSH_STATUS_FILE="/run/ourbox-installer-ssh-status.env"
SSH_PASSWORD_FILE="/run/ourbox-installer-ssh-password.txt"
INSTALLER_MONITOR_BROADCAST_PORT="9999"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

banner() {
  local ip
  local ssh_cmd ssh_detail
  ip="$(ip route get 10.255.255.255 2>/dev/null | awk '/src/ {print $7; exit}' || true)"
  _load_installer_monitor_settings
  _installer_ssh_banner_state
  ssh_cmd="${INSTALLER_SSH_BANNER_CMD}"
  ssh_detail="${INSTALLER_SSH_BANNER_DETAIL}"
  clear
  echo
  echo "  =================================================================="
  echo "  OurBox Woodbox — Installer"
  echo "  =================================================================="
  if [[ -n "${ip}" ]]; then
    echo "  Network monitoring:"
    echo "    SSH     : ${ssh_cmd//__IP__/${ip}}"
    if [[ -n "${ssh_detail}" ]]; then
      echo "              ${ssh_detail}"
    fi
    echo "    Browser : http://${ip}:8888/"
    echo "    UDP     : socat UDP-RECV:${INSTALLER_MONITOR_BROADCAST_PORT},reuseaddr -"
  fi
  echo "  =================================================================="
  echo
  _print_local_ssh_password_panel
}

prompt_confirm_exact() {
  local expected="$1" prompt="$2" ans=""
  read -r -p "${prompt} " ans
  [[ "${ans}" == "${expected}" ]] || die "confirmation did not match (expected: ${expected})"
}

_load_installer_ssh_status() {
  OURBOX_INSTALLER_SSH_STATUS="pending"
  OURBOX_INSTALLER_SSH_USER="ourbox-installer"
  OURBOX_INSTALLER_SSH_MODE="both"
  OURBOX_INSTALLER_SSH_PASSWORD_STATE="disabled"
  OURBOX_INSTALLER_SSH_KEY_STATE="disabled"

  if [[ -f "${SSH_STATUS_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${SSH_STATUS_FILE}"
  fi
}

_load_installer_monitor_settings() {
  INSTALLER_MONITOR_BROADCAST_PORT="9999"

  if [[ -f "${DEFAULTS_ENV}" ]]; then
    # shellcheck disable=SC1090
    source "${DEFAULTS_ENV}"
    if [[ "${OURBOX_INSTALLER_MONITOR_BROADCAST_PORT:-}" =~ ^[0-9]+$ ]] \
      && (( OURBOX_INSTALLER_MONITOR_BROADCAST_PORT >= 1 && OURBOX_INSTALLER_MONITOR_BROADCAST_PORT <= 65535 )); then
      INSTALLER_MONITOR_BROADCAST_PORT="${OURBOX_INSTALLER_MONITOR_BROADCAST_PORT}"
    fi
  fi
}

_installer_ssh_banner_state() {
  _load_installer_ssh_status

  case "${OURBOX_INSTALLER_SSH_STATUS}" in
    ready)
      INSTALLER_SSH_BANNER_CMD="ssh ${OURBOX_INSTALLER_SSH_USER}@__IP__"
      INSTALLER_SSH_BANNER_DETAIL=""
      if [[ "${OURBOX_INSTALLER_SSH_PASSWORD_STATE}" == "generated-console-only" ]]; then
        INSTALLER_SSH_BANNER_DETAIL="password shown on attached console only"
      elif [[ "${OURBOX_INSTALLER_SSH_PASSWORD_STATE}" == "configured-hash" ]]; then
        INSTALLER_SSH_BANNER_DETAIL="preconfigured password required"
      fi
      if [[ "${OURBOX_INSTALLER_SSH_KEY_STATE}" == "configured" ]]; then
        if [[ -n "${INSTALLER_SSH_BANNER_DETAIL}" ]]; then
          INSTALLER_SSH_BANNER_DETAIL="${INSTALLER_SSH_BANNER_DETAIL}; authorized keys accepted"
        elif [[ "${OURBOX_INSTALLER_SSH_MODE}" == "key" ]]; then
          INSTALLER_SSH_BANNER_DETAIL="authorized key required"
        else
          INSTALLER_SSH_BANNER_DETAIL="authorized keys accepted"
        fi
      elif [[ "${OURBOX_INSTALLER_SSH_MODE}" == "key" ]]; then
        INSTALLER_SSH_BANNER_DETAIL="authorized key required"
      fi
      ;;
    disabled)
      INSTALLER_SSH_BANNER_CMD="disabled by media config"
      INSTALLER_SSH_BANNER_DETAIL="installer SSH is intentionally disabled"
      ;;
    error)
      INSTALLER_SSH_BANNER_CMD="unavailable; see installer log"
      INSTALLER_SSH_BANNER_DETAIL="installer SSH setup failed"
      ;;
    *)
      INSTALLER_SSH_BANNER_CMD="pending (mode=${OURBOX_INSTALLER_SSH_MODE})"
      INSTALLER_SSH_BANNER_DETAIL="installer is still preparing SSH"
      ;;
  esac
}

_print_local_ssh_password_panel() {
  local password console=""

  [[ -f "${SSH_PASSWORD_FILE}" ]] || return 0

  password="$(tr -d '\r\n' < "${SSH_PASSWORD_FILE}")"
  [[ -n "${password}" ]] || return 0

  _load_installer_ssh_status
  [[ "${OURBOX_INSTALLER_SSH_STATUS}" == "ready" ]] || return 0
  [[ "${OURBOX_INSTALLER_SSH_PASSWORD_STATE}" == "generated-console-only" ]] || return 0

  if [[ -w /dev/tty ]]; then
    console="/dev/tty"
  elif [[ -w /dev/tty1 ]]; then
    console="/dev/tty1"
  elif [[ -w /dev/console ]]; then
    console="/dev/console"
  else
    return 0
  fi

  {
    echo
    echo "  ------------------------------------------------------------------"
    echo "  Installer SSH password (local console only)"
    echo "  ------------------------------------------------------------------"
    printf '  User     : %s\n' "${OURBOX_INSTALLER_SSH_USER}"
    printf '  Password : %s\n' "${password}"
    echo "  ------------------------------------------------------------------"
    echo
  } > "${console}"
}

# ---------------------------------------------------------------------------
# disk detection
# ---------------------------------------------------------------------------

installer_disk() {
  # The disk backing the live USB (the one / is on)
  local src real parent
  src="$(findmnt -nr -o SOURCE / 2>/dev/null || true)"
  real="$(readlink -f "${src}" 2>/dev/null || echo "${src}")"
  parent="$(lsblk -no PKNAME "${real}" 2>/dev/null || true)"
  if [[ -n "${parent}" ]]; then
    echo "/dev/${parent}"
  else
    echo "${real}"
  fi
}

# OS disk candidates: any non-removable disk except the installer USB.
candidate_disks() {
  local installer
  installer="$(installer_disk)"
  lsblk -dn -o NAME,TYPE | awk '$2=="disk" {print "/dev/"$1}' | while read -r disk; do
    [[ "${disk}" != "${installer}" ]] || continue
    local rm
    rm="$(lsblk -dn -o RM "${disk}" 2>/dev/null | tr -d '[:space:]')"
    [[ "${rm}" != "1" ]] || continue
    echo "${disk}"
  done
}

# DATA disk candidates: non-removable, not the installer USB, not the OS disk.
# Any transport type (SATA, SAS, NVMe, etc.) — identified by exclusion, not size.
candidate_data_disks() {
  local installer os_disk
  installer="$(installer_disk)"
  os_disk="${TARGET_DISK}"
  lsblk -dn -o NAME,TYPE | awk '$2=="disk" {print "/dev/"$1}' | while read -r disk; do
    [[ "${disk}" != "${installer}" ]] || continue
    [[ "${disk}" != "${os_disk}" ]]  || continue
    local rm
    rm="$(lsblk -dn -o RM "${disk}" 2>/dev/null | tr -d '[:space:]')"
    [[ "${rm}" != "1" ]] || continue
    echo "${disk}"
  done
}

_disk_table_row() {
  local disk="$1" idx="$2"
  local size tran model serial
  size="$(lsblk -dn -o SIZE "${disk}" 2>/dev/null | tr -d '[:space:]')"
  tran="$(lsblk -dn -o TRAN "${disk}" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
  model="$(lsblk -dn -o MODEL "${disk}" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  serial="$(lsblk -dn -o SERIAL "${disk}" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -n "${tran}" ]]   || tran="-"
  [[ -n "${model}" ]]  || model="-"
  [[ -n "${serial}" ]] || serial="-"
  printf '  %-3s %-14s %-8s %-6s %-22.22s %-16.16s\n' \
    "${idx}" "${disk}" "${size}" "${tran}" "${model}" "${serial}"
}

_disk_table_header() {
  printf '\n  %-3s %-14s %-8s %-6s %-22s %-16s\n' \
    "#" "Device" "Size" "Tran" "Model" "Serial"
  echo "  -----------------------------------------------------------------------"
}

print_disk_table() {
  local idx=0
  _disk_table_header
  while read -r disk; do
    idx=$((idx + 1))
    _disk_table_row "${disk}" "${idx}"
  done < <(candidate_disks)
  echo
}

print_data_disk_table() {
  local idx=0
  _disk_table_header
  while read -r disk; do
    idx=$((idx + 1))
    _disk_table_row "${disk}" "${idx}"
  done < <(candidate_data_disks)
  echo
}

select_disk() {
  local disks=() idx selected serial

  while true; do
    mapfile -t disks < <(candidate_disks)

    if (( ${#disks[@]} == 0 )); then
      echo
      echo "  No OS disk candidates found (non-removable, non-USB)."
      echo "  Make sure a target disk is connected, then rescan."
      read -r -p "  Press ENTER to rescan, or q to quit: " _ans
      [[ "${_ans}" == "q" || "${_ans}" == "Q" ]] && die "operator quit"
      continue
    fi

    print_disk_table
    read -r -p "  Select OS disk number (r=rescan, q=quit): " _ans
    case "${_ans}" in
      r|R) continue ;;
      q|Q) die "operator quit" ;;
    esac

    [[ "${_ans}" =~ ^[0-9]+$ ]] || { log "invalid selection"; continue; }
    idx=$(( _ans - 1 ))
    (( idx >= 0 && idx < ${#disks[@]} )) || { log "selection out of range"; continue; }

    selected="${disks[${idx}]}"
    echo
    lsblk -o NAME,SIZE,MODEL,SERIAL,TYPE,FSTYPE,LABEL,MOUNTPOINTS "${selected}" || true
    echo
    prompt_confirm_exact "INSTALL-TO-THIS-DISK" \
      "  Type INSTALL-TO-THIS-DISK to confirm this is the OS disk:"

    serial="$(lsblk -dn -o SERIAL "${selected}" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    TARGET_DISK="${selected}"
    TARGET_DISK_SERIAL="${serial}"
    return 0
  done
}

select_data_disk() {
  local disks=() idx selected

  while true; do
    mapfile -t disks < <(candidate_data_disks)

    if (( ${#disks[@]} == 0 )); then
      echo
      echo "  No DATA disk candidates found (non-removable, non-OS, non-USB)."
      echo "  Make sure the data drive is connected, then rescan."
      read -r -p "  Press ENTER to rescan, or q to quit: " _ans
      [[ "${_ans}" == "q" || "${_ans}" == "Q" ]] && die "operator quit"
      continue
    fi

    print_data_disk_table
    read -r -p "  Select DATA disk number (r=rescan, q=quit): " _ans
    case "${_ans}" in
      r|R) continue ;;
      q|Q) die "operator quit" ;;
    esac

    [[ "${_ans}" =~ ^[0-9]+$ ]] || { log "invalid selection"; continue; }
    idx=$(( _ans - 1 ))
    (( idx >= 0 && idx < ${#disks[@]} )) || { log "selection out of range"; continue; }

    selected="${disks[${idx}]}"
    echo
    lsblk -o NAME,SIZE,MODEL,SERIAL,TYPE,FSTYPE,LABEL,MOUNTPOINTS "${selected}" || true
    echo
    echo "  WARNING: ALL DATA ON ${selected} WILL BE PERMANENTLY ERASED"
    echo "  and formatted as the OurBox data volume (LABEL=OURBOX_DATA)."
    echo
    prompt_confirm_exact "FORMAT-AS-DATA" \
      "  Type FORMAT-AS-DATA to confirm this is the data disk:"

    DATA_DISK="${selected}"
    return 0
  done
}

