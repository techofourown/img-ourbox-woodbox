validate_installed_target_ssh_authorized_key() {
  local key_path="$1"
  local -a key_lines=()

  [[ -f "${key_path}" ]] || die "installed-target SSH authorized key missing: ${key_path}"
  mapfile -t key_lines < <(awk 'NF {print $0}' "${key_path}")
  [[ "${#key_lines[@]}" -eq 1 ]] || die "installed-target SSH authorized key must contain exactly one non-empty public key line"
  [[ "${key_lines[0]}" == ssh-ed25519\ * ]] || die "installed-target SSH authorized key must be an ssh-ed25519 public key"
}

prompt_installed_target_ssh_password_posture() {
  OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED=0

  echo
  echo "  Installed-system SSH"
  if [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" == "1" ]]; then
    echo "  A host-staged SSH key will be authorized for ${OURBOX_USERNAME}:"
    echo "    Key name    : ${MISSION_INSTALLED_TARGET_SSH_KEY_NAME}"
    echo "    Fingerprint : ${MISSION_INSTALLED_TARGET_SSH_PUBLIC_KEY_FINGERPRINT}"
    if prompt_yes_no_default_no "  Also allow password SSH login for ${OURBOX_USERNAME}?"; then
      OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED=1
    fi
    return 0
  fi

  echo "  No host-staged SSH key is present on this mission media."
  if prompt_yes_no_default_no "  Enable installed-system SSH password login for ${OURBOX_USERNAME}?"; then
    OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED=1
  fi
}

installed_target_ssh_summary_mode() {
  if [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" == "1" && "${OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED}" == "1" ]]; then
    printf '%s\n' "key + password"
  elif [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" == "1" ]]; then
    printf '%s\n' "key-only"
  elif [[ "${OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED}" == "1" ]]; then
    printf '%s\n' "password-only"
  else
    printf '%s\n' "disabled"
  fi
}

render_installed_target_ssh_autoinstall_block() {
  local allow_pw="false"
  local authorized_key=""

  if [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" != "1" && "${OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED}" != "1" ]]; then
    return 0
  fi

  if [[ "${OURBOX_INSTALLED_TARGET_SSH_PASSWORD_ENABLED}" == "1" ]]; then
    allow_pw="true"
  fi

  printf '  ssh:\n'
  printf '    allow-pw: %s\n' "${allow_pw}"
  if [[ "${MISSION_INSTALLED_TARGET_SSH_PRESENT}" == "1" ]]; then
    validate_installed_target_ssh_authorized_key "${MISSION_INSTALLED_TARGET_SSH_AUTHORIZED_KEY_PATH}"
    authorized_key="$(awk 'NF {print $0; exit}' "${MISSION_INSTALLED_TARGET_SSH_AUTHORIZED_KEY_PATH}")"
    printf '    authorized-keys:\n'
    printf '      - %s\n' "$(yaml_double_quote "${authorized_key}")"
  else
    printf '    authorized-keys: []\n'
  fi
}

validate_extracted_airgap_platform_bundle() {
  local bundle_dir="$1"
  local required_contract_digest="$2"
  local expected_arch="$3"
  local manifest="${bundle_dir}/manifest.env"
  local airgap_images_tar="${bundle_dir}/k3s/k3s-airgap-images-${expected_arch}.tar"
  local manifest_dump=""
  local -a manifest_fields=()

  [[ -f "${manifest}" ]] || die "airgap-platform bundle missing manifest.env: ${manifest}"
  [[ -x "${bundle_dir}/k3s/k3s" ]] || die "airgap-platform bundle missing k3s binary: ${bundle_dir}/k3s/k3s"
  [[ -f "${airgap_images_tar}" ]] || die "airgap-platform bundle missing k3s airgap images tar: ${airgap_images_tar}"
  [[ -f "${bundle_dir}/platform/images.lock.json" ]] || die "airgap-platform bundle missing platform/images.lock.json"
  [[ -f "${bundle_dir}/platform/profile.env" ]] || die "airgap-platform bundle missing platform/profile.env"
  [[ -d "${bundle_dir}/platform/images" ]] || die "airgap-platform bundle missing platform/images directory"
  find "${bundle_dir}/platform/images" -maxdepth 1 -type f -name '*.tar' -print -quit | grep -q . \
    || die "airgap-platform bundle missing platform image tar payloads: ${bundle_dir}/platform/images"

  manifest_dump="$(
    strict_metadata_values "${manifest}" \
      --allow OURBOX_AIRGAP_PLATFORM_SCHEMA \
      --allow OURBOX_AIRGAP_PLATFORM_KIND \
      --allow OURBOX_AIRGAP_PLATFORM_SOURCE \
      --allow OURBOX_AIRGAP_PLATFORM_REVISION \
      --allow OURBOX_AIRGAP_PLATFORM_VERSION \
      --allow OURBOX_AIRGAP_PLATFORM_CREATED \
      --allow OURBOX_PLATFORM_CONTRACT_REF \
      --allow OURBOX_PLATFORM_CONTRACT_DIGEST \
      --allow AIRGAP_PLATFORM_ARCH \
      --allow K3S_VERSION \
      --allow OURBOX_PLATFORM_PROFILE \
      --allow OURBOX_PLATFORM_IMAGES_LOCK_PATH \
      --allow OURBOX_PLATFORM_IMAGES_LOCK_SHA256 \
      --require OURBOX_AIRGAP_PLATFORM_SOURCE \
      --require OURBOX_AIRGAP_PLATFORM_REVISION \
      --require OURBOX_AIRGAP_PLATFORM_VERSION \
      --require OURBOX_AIRGAP_PLATFORM_CREATED \
      --require OURBOX_PLATFORM_CONTRACT_DIGEST \
      --require AIRGAP_PLATFORM_ARCH \
      --require K3S_VERSION \
      --require OURBOX_PLATFORM_PROFILE \
      --require OURBOX_PLATFORM_IMAGES_LOCK_PATH \
      --require OURBOX_PLATFORM_IMAGES_LOCK_SHA256 \
      --print OURBOX_AIRGAP_PLATFORM_SOURCE \
      --print OURBOX_AIRGAP_PLATFORM_REVISION \
      --print OURBOX_AIRGAP_PLATFORM_VERSION \
      --print OURBOX_AIRGAP_PLATFORM_CREATED \
      --print OURBOX_PLATFORM_CONTRACT_DIGEST \
      --print AIRGAP_PLATFORM_ARCH \
      --print K3S_VERSION \
      --print OURBOX_PLATFORM_PROFILE \
      --print OURBOX_PLATFORM_IMAGES_LOCK_PATH \
      --print OURBOX_PLATFORM_IMAGES_LOCK_SHA256
  )" || die "failed to parse airgap-platform manifest: ${manifest}"
  mapfile -t manifest_fields <<<"${manifest_dump}"
  [[ "${#manifest_fields[@]}" -eq 10 ]] \
    || die "airgap-platform manifest parse produced an unexpected field set: ${manifest}"

  [[ "${required_contract_digest}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "required platform contract digest must be a sha256:<64 hex> before validating airgap-platform bundle"
  [[ "${manifest_fields[4]}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "airgap-platform manifest carries invalid OURBOX_PLATFORM_CONTRACT_DIGEST"
  [[ "${manifest_fields[5]}" == "${expected_arch}" ]] || die "airgap-platform bundle arch mismatch: expected ${expected_arch}, got ${manifest_fields[5]:-unknown}"
  [[ "${manifest_fields[4]}" == "${required_contract_digest}" ]] || die "airgap-platform bundle contract digest mismatch: expected ${required_contract_digest}, got ${manifest_fields[4]}"
  [[ "${manifest_fields[9]}" =~ ^[0-9a-f]{64}$ ]] || die "airgap-platform manifest carries invalid OURBOX_PLATFORM_IMAGES_LOCK_SHA256"

  OURBOX_AIRGAP_PLATFORM_SOURCE="${manifest_fields[0]}"
  OURBOX_AIRGAP_PLATFORM_REVISION="${manifest_fields[1]}"
  OURBOX_AIRGAP_PLATFORM_VERSION="${manifest_fields[2]}"
  OURBOX_AIRGAP_PLATFORM_CREATED="${manifest_fields[3]}"
  OURBOX_AIRGAP_PLATFORM_ARCH="${manifest_fields[5]}"
  OURBOX_AIRGAP_PLATFORM_PROFILE="${manifest_fields[7]}"
  OURBOX_AIRGAP_PLATFORM_K3S_VERSION="${manifest_fields[6]}"
  OURBOX_AIRGAP_PLATFORM_IMAGES_LOCK_SHA256="${manifest_fields[9]}"
}

# _stage_embedded_payload — copy embedded payload from mission media into cache dir
_stage_embedded_payload() {
  local embedded="/cdrom/ourbox/payload/os-payload.tar.gz"
  mkdir -p "${PAYLOAD_CACHE_DIR}"
  cp "${embedded}" "${PAYLOAD_CACHE_DIR}/os-payload.tar.gz"
  [[ -f "${embedded}.sha256" ]] && \
    cp "${embedded}.sha256" "${PAYLOAD_CACHE_DIR}/os-payload.tar.gz.sha256"
  [[ -f "/cdrom/ourbox/payload/payload.meta.env" ]] && \
    cp "/cdrom/ourbox/payload/payload.meta.env" "${PAYLOAD_CACHE_DIR}/payload.meta.env"
}

# _verify_staged_payload — verify SHA256 and set OS_IMAGE_SHA256
_verify_staged_payload() {
  [[ -f "${PAYLOAD_CACHE_DIR}/os-payload.tar.gz" ]] || \
    die "OS payload not staged: ${PAYLOAD_CACHE_DIR}/os-payload.tar.gz"

  local sha256_file="${PAYLOAD_CACHE_DIR}/os-payload.tar.gz.sha256"
  if [[ -f "${sha256_file}" ]]; then
    local expected actual
    expected="$(awk 'NF>=1 {print $1; exit}' "${sha256_file}")"
    expected="${expected,,}"
    [[ "${expected}" =~ ^[0-9a-f]{64}$ ]] || die "invalid sha256 in os-payload.tar.gz.sha256"
    actual="$(sha256sum "${PAYLOAD_CACHE_DIR}/os-payload.tar.gz" | awk '{print $1}')"
    [[ "${expected}" == "${actual}" ]] || \
      die "OS payload SHA256 mismatch
  expected: ${expected}
  actual:   ${actual}"
    OS_IMAGE_SHA256="${actual}"
    log "  SHA256 verified: ${actual}"
  else
    OS_IMAGE_SHA256="$(sha256sum "${PAYLOAD_CACHE_DIR}/os-payload.tar.gz" | awk '{print $1}')"
    log "  SHA256: ${OS_IMAGE_SHA256} (no checksum file; not verified against expected)"
  fi
}

